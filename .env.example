APP_ENV=development
# Override the development demo passwords. Required outside development.
TECHNICIAN_PASSWORD=
COORDINATOR_PASSWORD=
DB_PATH=data/runtime/technician_scheduling.db

# Agent LLM backend: mock, local, or bedrock.
# "local" means the local-development OpenAI-compatible route; the endpoint may
# be a process on this computer (LM Studio/Ollama/vLLM) or a remote API such as OpenRouter.
LLM_BACKEND=mock

# OpenAI-compatible development backend.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_SEC=60

# OpenRouter example (uncomment/replace the LOCAL_LLM_* values above when needed):
# LLM_BACKEND=local
# LOCAL_LLM_BASE_URL=https://openrouter.ai/api/v1
# LOCAL_LLM_API_KEY=sk-or-v1-your-key-here
# LOCAL_LLM_MODEL=your-openrouter-model-id

AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=
SLOT_GRANULARITY_MIN=30
